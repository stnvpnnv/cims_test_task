# Docker Compose bootstrap. Copy this file to .env and set both passwords.
CIMS_POSTGRES_DB=cims
CIMS_POSTGRES_USER=cims
CIMS_POSTGRES_PASSWORD=
CIMS_POSTGRES_PORT=5432

CIMS_RABBITMQ_USER=cims
CIMS_RABBITMQ_PASSWORD=
CIMS_RABBITMQ_VHOST=cims
CIMS_RABBITMQ_AMQP_PORT=5672
CIMS_RABBITMQ_MANAGEMENT_PORT=15672

# Host-side application runtime. Python does not load .env automatically.
# Export these URLs after replacing and percent-encoding the password placeholders.
# CIMS_DATABASE_URL=postgresql+asyncpg://cims:<password>@localhost:5432/cims
# CIMS_RABBITMQ_URL=amqp://cims:<password>@localhost:5672/cims

# Container runtime. Compose maps these values to CIMS_DATABASE_URL and
# CIMS_RABBITMQ_URL. Service names replace localhost inside the Docker network.
# User, database, and vhost must match the bootstrap values above; passwords
# must be percent-encoded independently.
# CIMS_INTERNAL_DATABASE_URL=postgresql+asyncpg://cims:<password>@postgres:5432/cims
# CIMS_INTERNAL_RABBITMQ_URL=amqp://cims:<password>@rabbitmq:5672/cims
CIMS_INTERNAL_DATABASE_URL=
CIMS_INTERNAL_RABBITMQ_URL=
CIMS_API_PORT=8000

# Total execution attempts per task, including the first attempt.
# CIMS_TASK_MAX_ATTEMPTS=3

# Dispatcher process.
# Batch + 1 <= CIMS_DATABASE_POOL_SIZE + CIMS_DATABASE_MAX_OVERFLOW.
# Lease > CIMS_RABBITMQ_PUBLISH_TIMEOUT_SECONDS + CIMS_DATABASE_POOL_TIMEOUT_SECONDS.
# CIMS_DISPATCHER_BATCH_SIZE=10
# CIMS_DISPATCHER_POLL_INTERVAL_SECONDS=0.5
# CIMS_DISPATCHER_LEASE_DURATION_SECONDS=60
# CIMS_DISPATCHER_RETRY_INITIAL_DELAY_SECONDS=1
# CIMS_DISPATCHER_RETRY_MAXIMUM_DELAY_SECONDS=60
# CIMS_RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10
# Must remain below the 60-second Compose stop grace period.
# CIMS_DISPATCHER_SHUTDOWN_GRACE_SECONDS=45

# Expired execution recovery, supervised by the dispatcher process.
# Retry delay uses a capped exponential base with equal jitter of 50-100%.
# CIMS_EXECUTION_RECOVERY_BATCH_SIZE=10
# CIMS_EXECUTION_RECOVERY_POLL_INTERVAL_SECONDS=5
# CIMS_EXECUTION_RETRY_INITIAL_DELAY_SECONDS=5
# CIMS_EXECUTION_RETRY_MAXIMUM_DELAY_SECONDS=300

# Integration tests require an existing dedicated database ending in _test.
# Each test creates and removes its own schema; URL query parameters are forbidden.
# CIMS_TEST_DATABASE_URL=postgresql+asyncpg://cims:<password>@localhost:5432/cims_test

# RabbitMQ integration tests require an existing dedicated vhost ending in _test.
# Its user needs configure, write, and read permissions; query and fragment are forbidden.
# CIMS_TEST_RABBITMQ_URL=amqp://cims:<password>@localhost:5672/cims_test
