# Docker Compose variables for local infrastructure; Python does not load this file automatically.
# Copy this file to .env and set both passwords before running Docker Compose.
CIMS_POSTGRES_DB=cims
CIMS_POSTGRES_USER=cims
CIMS_POSTGRES_PASSWORD=
CIMS_POSTGRES_PORT=5432

CIMS_RABBITMQ_USER=cims
CIMS_RABBITMQ_PASSWORD=
CIMS_RABBITMQ_VHOST=cims
CIMS_RABBITMQ_AMQP_PORT=5672
CIMS_RABBITMQ_MANAGEMENT_PORT=15672
